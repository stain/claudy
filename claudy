#!/bin/bash
# Run the claudy container with only the current directory mounted.
#   claudy               Claude Code
#   claudy <cmd> [args]  any command, e.g. bash, snakemake --cores 4
#   claudy jupyter       Jupyter Notebook on http://localhost:8888
#   claudy pubkey        print this project's SSH public key
#
# Options (before the command):
#   --ports 8080,8081    publish these container ports 1:1 on 127.0.0.1 of the host,
#                        e.g. for a dev server (it must listen on 0.0.0.0 inside)
#
# Podman works inside the sandbox without extra options (vfs storage). Nested mode is opt-in:
#   CLAUDY_NESTED=1 claudy
# This passes /dev/fuse (faster overlay storage) and keeps inner images in a per-project volume. On WSL2 it refuses to run unless the
# distro has Windows drives and interop disabled (see README, "Dedicated WSL distro").
set -euo pipefail

ports=()
while [ $# -gt 0 ]; do
  case "$1" in
    --ports=*) list=${1#--ports=}; shift ;;
    --ports)
      [ $# -ge 2 ] || { echo "claudy: --ports needs a comma-separated list, e.g. --ports 8080,8081" >&2; exit 1; }
      list=$2; shift 2 ;;
    --) shift; break ;;
    *) break ;;
  esac
  IFS=, read -r -a items <<< "$list"
  for p in "${items[@]}"; do
    if ! [[ $p =~ ^[0-9]+$ ]] || [ "$p" -lt 1 ] || [ "$p" -gt 65535 ]; then
      echo "claudy: invalid port '$p' (expected 1-65535)" >&2; exit 1
    fi
    ports+=("$((10#$p))")
  done
done

NESTED=${CLAUDY_NESTED:-0}
IMAGE=${CLAUDY_IMAGE:-claudy}
CONFIG_VOLUME=${CLAUDY_CONFIG:-claude-config}

case "$PWD" in
  / | "$HOME" | /mnt/c | /mnt/c/Users/*)
    echo "claudy: refusing to mount $PWD; cd into a project folder first." >&2
    exit 1 ;;
esac

# One SSH key volume per project folder, so containers can't use each other's keys.
# The hash of the full path keeps same-named folders apart.
project=$(basename "$PWD")
hash=$(printf '%s' "$PWD" | sha256sum | cut -c1-8)
project_id=${project//[^A-Za-z0-9_.-]/_}-$hash
SSH_VOLUME=${CLAUDY_SSH:-claude-ssh-$project_id}

# The project is mounted at its own path, so Claude Code keeps each project's
# conversations (--continue, --resume) and memory apart. The entrypoint links
# /workspace to it, so paths written for /workspace keep working.
PROJECT_DIR=/projects/$project_id

opts=(-it --rm
  -v "$PWD":"$PROJECT_DIR"
  --workdir "$PROJECT_DIR"
  -e CLAUDY_PROJECT_DIR="$PROJECT_DIR"
  -v "$CONFIG_VOLUME":/claude-config
  -v "$SSH_VOLUME":/root/.ssh
  -e CLAUDY_PROJECT="$project")

# Seccomp: Podman's default profile, minus vsock. On WSL2 vsock is how the VM talks to
# Windows (interop, drvfs), and network namespaces don't isolate it. Every ALLOW rule for
# socket() gets "domain != AF_VSOCK" (a rule that already tests the domain loses socket;
# libseccomp can't compare one argument twice). socketcall (32-bit multiplexer) and
# io_uring could create sockets past that filter, so they are removed. Derived on every
# start, so it follows the installed Podman's defaults.
SECCOMP_BASE=${CLAUDY_SECCOMP_BASE:-/usr/share/containers/seccomp.json}
seccomp_dir=${XDG_CACHE_HOME:-$HOME/.cache}/claudy
mkdir -p "$seccomp_dir"
seccomp=$seccomp_dir/seccomp.json
python3 -I - "$SECCOMP_BASE" "$seccomp.$$" <<'PY' || { rm -f "$seccomp.$$"; echo "claudy: cannot derive a seccomp profile from $SECCOMP_BASE; set CLAUDY_SECCOMP_BASE to Podman's default seccomp.json" >&2; exit 1; }
import json, sys
AF_VSOCK = 40
REMOVE = {"socketcall", "io_uring_setup", "io_uring_enter", "io_uring_register"}
with open(sys.argv[1]) as f:
    profile = json.load(f)
rules = []
for rule in profile["syscalls"]:
    names = rule.get("names", [])
    if rule.get("action") != "SCMP_ACT_ALLOW" or not (set(names) & (REMOVE | {"socket"})):
        rules.append(rule)
        continue
    rest = [n for n in names if n not in REMOVE and n != "socket"]
    if rest:
        rules.append(dict(rule, names=rest))
    args = rule.get("args") or []
    if "socket" in names and not any(a["index"] == 0 for a in args):
        rules.append(dict(rule, names=["socket"],
                          args=args + [{"index": 0, "value": AF_VSOCK, "valueTwo": 0, "op": "SCMP_CMP_NE"}]))
if not any("socket" in r["names"] and r.get("action") == "SCMP_ACT_ALLOW" for r in rules):
    sys.exit("no ALLOW rule for socket() left")
profile["syscalls"] = rules
with open(sys.argv[2], "w") as f:
    json.dump(profile, f)
PY
mv "$seccomp.$$" "$seccomp"
opts+=(--security-opt seccomp="$seccomp")

# Optional commit identity (defaults come from the image)
if [ -n "${CLAUDY_GIT_NAME:-}" ]; then
  opts+=(-e GIT_AUTHOR_NAME="$CLAUDY_GIT_NAME" -e GIT_COMMITTER_NAME="$CLAUDY_GIT_NAME")
fi
if [ -n "${CLAUDY_GIT_EMAIL:-}" ]; then
  opts+=(-e GIT_AUTHOR_EMAIL="$CLAUDY_GIT_EMAIL" -e GIT_COMMITTER_EMAIL="$CLAUDY_GIT_EMAIL")
fi

if [ "$NESTED" = 1 ]; then
  [ -e /dev/fuse ] || { echo "claudy: /dev/fuse not found on this host; cannot run nested." >&2; exit 1; }
  # On WSL2, an escape from a container with /dev/fuse would reach the Windows drives
  # (and Windows programs via interop) as your Windows user. Require a distro without them.
  if grep -qi microsoft /proc/version 2>/dev/null && [ "${CLAUDY_ALLOW_UNSAFE_NESTED:-0}" != 1 ]; then
    if grep -qE ' /mnt/[a-z] (9p|drvfs) ' /proc/mounts \
       || [ -e /proc/sys/fs/binfmt_misc/WSLInterop ] || [ -e /proc/sys/fs/binfmt_misc/WSLInterop-late ]; then
      echo "claudy: nested mode refused: this WSL distro still has Windows drives mounted or interop enabled." >&2
      echo "            Use a dedicated distro configured as in the README, or set CLAUDY_ALLOW_UNSAFE_NESTED=1." >&2
      exit 1
    fi
  fi
  # Inner image storage persists per project, in its own volume
  opts+=(--device /dev/fuse --security-opt label=disable
         -v "claude-containers-$project_id":/var/lib/containers)
fi

if [ "${1:-}" = pubkey ]; then
  set -- cat /root/.ssh/id_ed25519.pub
fi

if [ "${1:-}" = jupyter ]; then
  ports+=(8888)
  set -- jupyter notebook --ip=0.0.0.0 --no-browser --allow-root
fi

# Published ports: host loopback only, same number inside and out. CLAUDY_PORTS tells
# the container which ports the user can reach from the host.
if [ ${#ports[@]} -gt 0 ]; then
  mapfile -t ports < <(printf '%s\n' "${ports[@]}" | sort -nu)
  for p in "${ports[@]}"; do
    opts+=(-p "127.0.0.1:$p:$p")
  done
  opts+=(-e CLAUDY_PORTS="$(IFS=,; echo "${ports[*]}")")
fi

exec podman run "${opts[@]}" "$IMAGE" "$@"

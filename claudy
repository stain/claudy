#!/bin/bash
# Run the claudy container with only the current directory mounted.
#   claudy               Claude Code
#   claudy <cmd> [args]  any command, e.g. bash, snakemake --cores 4
#   claudy jupyter       Jupyter Notebook on http://localhost:8888
#   claudy vscode        VS Code in the browser on http://localhost:8000 (CLAUDY_VSCODE_PORT)
#   claudy pubkey        print this project's SSH public key
#
# Options (before the command):
#   --ports 8080,8081    publish these container ports 1:1 on 127.0.0.1 of the host,
#                        e.g. for a dev server (it must listen on 0.0.0.0 inside)
#
# Podman works inside the sandbox without extra options (vfs storage). Nested mode is opt-in:
#   CLAUDY_NESTED=1 claudy
# This passes /dev/fuse (faster overlay storage) and keeps inner images in a per-project volume. On WSL2 it refuses to run unless the
# distro has Windows drives and interop disabled (see README, "Dedicated WSL distro").
set -euo pipefail

ports=()
while [ $# -gt 0 ]; do
  case "$1" in
    --ports=*) list=${1#--ports=}; shift ;;
    --ports)
      [ $# -ge 2 ] || { echo "claudy: --ports needs a comma-separated list, e.g. --ports 8080,8081" >&2; exit 1; }
      list=$2; shift 2 ;;
    --) shift; break ;;
    *) break ;;
  esac
  IFS=, read -r -a items <<< "$list"
  for p in "${items[@]}"; do
    if ! [[ $p =~ ^[0-9]+$ ]] || [ "$p" -lt 1 ] || [ "$p" -gt 65535 ]; then
      echo "claudy: invalid port '$p' (expected 1-65535)" >&2; exit 1
    fi
    ports+=("$((10#$p))")
  done
done

NESTED=${CLAUDY_NESTED:-0}
# Fully qualified local name, and run never pulls (below): a short name with no local
# image could otherwise be looked up in a registry, depending on the host's config.
IMAGE=${CLAUDY_IMAGE:-localhost/claudy:latest}
CONFIG_VOLUME=${CLAUDY_CONFIG:-claude-config}

case "$PWD" in
  / | "$HOME" | /mnt/c | /mnt/c/Users/*)
    echo "claudy: refusing to mount $PWD; cd into a project folder first." >&2
    exit 1 ;;
esac

# One SSH key volume per project folder, so containers can't use each other's keys.
# The hash of the full path keeps same-named folders apart.
project=$(basename "$PWD")
hash=$(printf '%s' "$PWD" | sha256sum | cut -c1-8)
project_id=${project//[^A-Za-z0-9_.-]/_}-$hash
SSH_VOLUME=${CLAUDY_SSH:-claude-ssh-$project_id}

# Warn (don't refuse) when a parent folder was already used as a claudy project: this
# subfolder gets its own key, conda env and conversation history, and the parent's
# files are not mounted. Signs: the parent's SSH volume, or the entrypoint's env stamp.
volumes=$(podman volume ls --format '{{.Name}}' 2>/dev/null || true)
dir=$(dirname "$PWD")
while [ "$dir" != / ]; do
  dir_id=$(basename "$dir"); dir_id=${dir_id//[^A-Za-z0-9_.-]/_}-$(printf '%s' "$dir" | sha256sum | cut -c1-8)
  if grep -qxF "claude-ssh-$dir_id" <<< "$volumes" || [ -f "$dir/.conda_env/.environment.yml.stamp" ]; then
    echo "claudy: $dir is already a claudy project; starting one for the subfolder $PWD instead" >&2
    echo "            (own SSH key, conda env and conversations; cd $dir to use the parent's)." >&2
    echo "            Starting in 5 seconds; press Ctrl-C to stop." >&2
    sleep 5
    break
  fi
  dir=$(dirname "$dir")
done

# Warn (don't rebuild) when the image is older than the files it is built from, e.g.
# after a git pull: this script takes effect at once, the image only after a rebuild.
repo=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
if built=$(podman image inspect --format '{{.Created.Unix}}' "$IMAGE" 2>/dev/null); then
  for f in Dockerfile entrypoint.sh vscode-serve.sh git-identity-notice.sh claude-shell.bashrc etc-claude-code/CLAUDE.md; do
    if [ -f "$repo/$f" ] && [ "$(stat -c %Y "$repo/$f")" -gt "$built" ]; then
      echo "claudy: $f changed since image '$IMAGE' was built; rebuild it: podman build -t $IMAGE $repo" >&2
      break
    fi
  done
fi

# The project is mounted at its own path, so Claude Code keeps each project's
# conversations (--continue, --resume) and memory apart. The entrypoint links
# /workspace to it, so paths written for /workspace keep working. Images built
# before that change lack the label and get the old /workspace mount.
PROJECT_DIR=/projects/$project_id
if label=$(podman image inspect --format '{{index .Config.Labels "org.claudy.project-dir"}}' "$IMAGE" 2>/dev/null) \
   && [ "$label" != 1 ]; then
  echo "claudy: image '$IMAGE' predates per-project paths; mounting at /workspace until it is rebuilt." >&2
  PROJECT_DIR=/workspace
fi

opts=(-it --rm
  -v "$PWD":"$PROJECT_DIR"
  --workdir "$PROJECT_DIR"
  -e CLAUDY_PROJECT_DIR="$PROJECT_DIR"
  -v "$CONFIG_VOLUME":/claude-config
  -v "$SSH_VOLUME":/root/.ssh
  -e CLAUDY_PROJECT="$project")

# Seccomp: Podman's default profile, minus vsock. On WSL2 vsock is how the VM talks to
# Windows (interop, drvfs), and network namespaces don't isolate it. Every ALLOW rule for
# socket() gets "domain != AF_VSOCK" (a rule that already tests the domain loses socket;
# libseccomp can't compare one argument twice, unless the profile already denies AF_VSOCK
# itself, as newer Podman defaults do). socketcall (32-bit multiplexer) and
# io_uring could create sockets past that filter, so they are removed, and with them the
# 32-bit sub-architectures (no 32-bit binaries in the container). Derived on every
# start, so it follows the installed Podman's defaults.
SECCOMP_BASE=${CLAUDY_SECCOMP_BASE:-/usr/share/containers/seccomp.json}
seccomp_dir=${XDG_CACHE_HOME:-$HOME/.cache}/claudy
mkdir -p "$seccomp_dir"
seccomp=$seccomp_dir/seccomp.json
python3 -I - "$SECCOMP_BASE" "$seccomp.$$" <<'PY' || { rm -f "$seccomp.$$"; echo "claudy: cannot derive a seccomp profile from $SECCOMP_BASE; set CLAUDY_SECCOMP_BASE to Podman's default seccomp.json" >&2; exit 1; }
import json, sys
AF_VSOCK = 40
REMOVE = {"socketcall", "io_uring_setup", "io_uring_enter", "io_uring_register"}
with open(sys.argv[1]) as f:
    profile = json.load(f)
def tests_domain(rule):
    return any(a["index"] == 0 for a in rule.get("args") or [])
# Newer Podman profiles deny AF_VSOCK themselves (an ERRNO rule for socket() with domain 40)
# and their ALLOW rules already test the domain; those are kept as they are.
denied = any("socket" in r["names"] and r.get("action") in ("SCMP_ACT_ERRNO", "SCMP_ACT_KILL")
            and any(a["index"] == 0 and a["op"] == "SCMP_CMP_EQ" and a["value"] == AF_VSOCK
                    for a in r.get("args") or [])
            and not r.get("includes") and not r.get("excludes")
            for r in profile["syscalls"])
rules = []
for rule in profile["syscalls"]:
    names = rule.get("names", [])
    if rule.get("action") != "SCMP_ACT_ALLOW" or not (set(names) & (REMOVE | {"socket"})):
        rules.append(rule)
        continue
    keep_socket = "socket" in names and tests_domain(rule) and denied
    rest = [n for n in names if n not in REMOVE and (n != "socket" or keep_socket)]
    if rest:
        rules.append(dict(rule, names=rest))
    if "socket" in names and not tests_domain(rule):
        rules.append(dict(rule, names=["socket"],
                          args=(rule.get("args") or []) + [{"index": 0, "value": AF_VSOCK, "valueTwo": 0, "op": "SCMP_CMP_NE"}]))
if not any("socket" in r["names"] and r.get("action") == "SCMP_ACT_ALLOW" for r in rules):
    sys.exit("no ALLOW rule for socket() left")
profile["syscalls"] = rules
# Without socketcall, libseccomp can't add the socket() rules for the 32-bit sub-architectures
# (EEXIST), and 32-bit syscalls would bypass the domain test anyway: allow the native one only.
for entry in profile.get("archMap", []):
    entry["subArchitectures"] = []
with open(sys.argv[2], "w") as f:
    json.dump(profile, f)
PY
mv "$seccomp.$$" "$seccomp"
opts+=(--security-opt seccomp="$seccomp")

# Optional commit identity (defaults come from the image)
if [ -n "${CLAUDY_GIT_NAME:-}" ]; then
  opts+=(-e GIT_AUTHOR_NAME="$CLAUDY_GIT_NAME" -e GIT_COMMITTER_NAME="$CLAUDY_GIT_NAME")
fi
if [ -n "${CLAUDY_GIT_EMAIL:-}" ]; then
  opts+=(-e GIT_AUTHOR_EMAIL="$CLAUDY_GIT_EMAIL" -e GIT_COMMITTER_EMAIL="$CLAUDY_GIT_EMAIL")
fi

# Warn when commits would still carry the image's placeholder author. Setting
# CLAUDY_GIT_NAME and CLAUDY_GIT_EMAIL, to anything, silences it.
if [ "${1:-}" != pubkey ] \
   && image_env=$(podman image inspect --format '{{range .Config.Env}}{{println .}}{{end}}' "$IMAGE" 2>/dev/null); then
  placeholder=()
  [ -n "${CLAUDY_GIT_NAME:-}" ] || ! grep -qx 'GIT_AUTHOR_NAME=Claude Sandbox' <<< "$image_env" || placeholder+=(name)
  [ -n "${CLAUDY_GIT_EMAIL:-}" ] || ! grep -qx 'GIT_AUTHOR_EMAIL=claude-sandbox@localhost' <<< "$image_env" || placeholder+=(email)
  if [ ${#placeholder[@]} -gt 0 ]; then
    echo "claudy: commits will use the sandbox placeholder $(IFS=/; echo "${placeholder[*]}") (Claude Sandbox <claude-sandbox@localhost>)." >&2
    echo "            Set CLAUDY_GIT_NAME and CLAUDY_GIT_EMAIL to choose the author (README, Commit author)." >&2
    echo "            Starting in 3 seconds; press Ctrl-C to stop." >&2
    sleep 3
  fi
fi

if [ "$NESTED" = 1 ]; then
  [ -e /dev/fuse ] || { echo "claudy: /dev/fuse not found on this host; cannot run nested." >&2; exit 1; }
  # On WSL2, an escape from a container with /dev/fuse would reach the Windows drives
  # (and Windows programs via interop) as your Windows user. Require a distro without them.
  if grep -qi microsoft /proc/version 2>/dev/null && [ "${CLAUDY_ALLOW_UNSAFE_NESTED:-0}" != 1 ]; then
    if grep -qE ' /mnt/[a-z] (9p|drvfs) ' /proc/mounts \
       || [ -e /proc/sys/fs/binfmt_misc/WSLInterop ] || [ -e /proc/sys/fs/binfmt_misc/WSLInterop-late ]; then
      echo "claudy: nested mode refused: this WSL distro still has Windows drives mounted or interop enabled." >&2
      echo "            Use a dedicated distro configured as in the README, or set CLAUDY_ALLOW_UNSAFE_NESTED=1." >&2
      exit 1
    fi
  fi
  # Inner image storage persists per project, in its own volume
  opts+=(--device /dev/fuse --security-opt label=disable
         -v "claude-containers-$project_id":/var/lib/containers)
fi

if [ "${1:-}" = pubkey ]; then
  set -- cat /root/.ssh/id_ed25519.pub
fi

# Claude as a job of an interactive bash in the container, not PID 1, so Ctrl-Z
# suspends it to that shell (images without the label run it directly)
if [ "${1:-}" = claude ] \
   && [ "$(podman image inspect --format '{{index .Config.Labels "org.claudy.claude-shell"}}' "$IMAGE" 2>/dev/null)" = 1 ]; then
  shift
  set -- /bin/bash --rcfile /usr/local/share/claudy/claude-shell.bashrc -i -s -- "$@"
fi

if [ "${1:-}" = jupyter ]; then
  ports+=(8888)
  set -- jupyter notebook --ip=0.0.0.0 --no-browser --allow-root
fi

# VS Code server and extensions persist in a per-project volume: a shared one would let
# an extension installed in one project run in another.
if [ "${1:-}" = vscode ]; then
  vscode_port=${CLAUDY_VSCODE_PORT:-8000}
  if ! [[ $vscode_port =~ ^[0-9]+$ ]] || [ "$vscode_port" -lt 1024 ] || [ "$vscode_port" -gt 65535 ]; then
    echo "claudy: invalid CLAUDY_VSCODE_PORT '$vscode_port' (expected 1024-65535)" >&2; exit 1
  fi
  ports+=("$((10#$vscode_port))")
  opts+=(-v "claude-vscode-$project_id":/root/.vscode-claudy
         -e CLAUDY_VSCODE_PORT="$((10#$vscode_port))")
  set -- vscode-serve "$((10#$vscode_port))"
fi

# Published ports: host loopback only, same number inside and out. CLAUDY_PORTS tells
# the container which ports the user can reach from the host.
if [ ${#ports[@]} -gt 0 ]; then
  mapfile -t ports < <(printf '%s\n' "${ports[@]}" | sort -nu)
  for p in "${ports[@]}"; do
    opts+=(-p "127.0.0.1:$p:$p")
  done
  opts+=(-e CLAUDY_PORTS="$(IFS=,; echo "${ports[*]}")")
fi

exec podman run --pull=never "${opts[@]}" "$IMAGE" "$@"
